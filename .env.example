# Copy to .env and adjust. Every variable is optional: empty = built-in default.
# Apply with: docker compose up -d   (no rebuild needed)

# --- Docker -------------------------------------------------------------
HOST_PORT=8080
# IMAGE_NAME=mail-setup
# CONTAINER_NAME=mail-setup

# --- Branding -----------------------------------------------------------
BRAND_NAME=Mail Setup
# Local path (/img/...) or absolute https URL; empty = text logo + neutral icon
BRAND_LOGO_URL=
# Accent colour, #rgb or #rrggbb
BRAND_ACCENT=#2563eb

# --- Mail servers -------------------------------------------------------
MAIL_HOST=mail.example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURITY=SSL/TLS
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=SSL/TLS
WEBMAIL_URL=https://mail.example.com/

# --- Calendar and contacts (CalDAV / CardDAV) ---------------------------
# mdaemon (default) or generic (standard .well-known discovery)
DAV_PRESET=mdaemon
# Defaults to https://$MAIL_HOST
DAV_BASE_URL=
# Override individual URLs only if the preset does not fit.
# Templates accept {email}, {local} (part before @) and {domain}.
CALDAV_URL=
CARDDAV_URL=
TASKS_URL=
DAV_DISCOVERY_URL=
DAV_CARD_DISCOVERY_URL=
DAV_PRINCIPAL_URL_TEMPLATE=
DAV_CALENDAR_URL_TEMPLATE=
DAV_TASKS_URL_TEMPLATE=
DAV_CONTACTS_URL_TEMPLATE=

# --- Public address of this app (used in links and QR codes) ------------
PUBLIC_URL=https://config.example.com

# --- Support contact (all optional, hidden when empty) ------------------
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=
SUPPORT_ADDRESS=

# --- Internal /support page (HTTP Basic) --------------------------------
# Empty password = page disabled (404). Generate one: openssl rand -base64 24
SUPPORT_USER=support
SUPPORT_PASSWORD=

# --- Apple configuration profile ----------------------------------------
# Defaults to BRAND_NAME
PROFILE_ORGANIZATION=
PROFILE_ID_PREFIX=com.example.mailsetup
